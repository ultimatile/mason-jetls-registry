{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "separateMinorPatch": false,
  "prConcurrentLimit": 3,
  "prCreation": "immediate",
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/.*/package\\.yaml$/"
      ],
      "matchStrings": [
        "id:\\s*pkg:github/(?<depName>[^@]+)@(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>.*)$",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "ultimatile/jetls-sysimage"
      ],
      "commitMessageTopic": "jetls-sysimage",
      "commitMessageExtra": "to {{newValue}}"
    }
  ]
}
